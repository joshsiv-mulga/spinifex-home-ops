{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Api": {
      "additionalProperties": false,
      "properties": {
        "addr": {
          "anyOf": [
            {
              "format": "ipv4",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Addr"
        },
        "host": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fqdn"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tls_sans": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Fqdn"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tls Sans"
        }
      },
      "title": "Api",
      "type": "object"
    },
    "Asn": {
      "type": "string"
    },
    "Bgp": {
      "additionalProperties": false,
      "properties": {
        "router_addr": {
          "anyOf": [
            {
              "format": "ipv4",
              "type": "string"
            },
            {
              "const": "",
              "type": "string"
            }
          ],
          "default": "",
          "title": "Router Addr"
        },
        "router_asn": {
          "$ref": "#/$defs/Asn",
          "default": ""
        },
        "node_asn": {
          "$ref": "#/$defs/Asn",
          "default": ""
        }
      },
      "title": "Bgp",
      "type": "object"
    },
    "Cidr": {
      "format": "ipv4network",
      "type": "string"
    },
    "Cilium": {
      "additionalProperties": false,
      "properties": {
        "loadbalancer_mode": {
          "anyOf": [
            {
              "enum": ["dsr", "snat"],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loadbalancer Mode"
        },
        "bgp": {
          "$ref": "#/$defs/Bgp",
          "default": {
            "router_addr": "",
            "router_asn": "",
            "node_asn": ""
          }
        }
      },
      "title": "Cilium",
      "type": "object"
    },
    "Dns": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "default": "cloudflare",
          "enum": ["cloudflare", "spinifex", "none"],
          "title": "Provider",
          "type": "string"
        },
        "token": {
          "default": "",
          "title": "Token",
          "type": "string"
        }
      },
      "title": "Dns",
      "type": "object"
    },
    "Domain": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/Fqdn"
        }
      },
      "required": ["name"],
      "title": "Domain",
      "type": "object"
    },
    "Fqdn": {
      "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,}$",
      "type": "string"
    },
    "Gateways": {
      "additionalProperties": false,
      "properties": {
        "internal": {
          "anyOf": [
            {
              "format": "ipv4",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Internal"
        },
        "dns": {
          "anyOf": [
            {
              "format": "ipv4",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dns"
        },
        "external": {
          "anyOf": [
            {
              "format": "ipv4",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External"
        }
      },
      "title": "Gateways",
      "type": "object"
    },
    "Ingress": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "cloudflare-tunnel",
          "enum": ["cloudflare-tunnel", "direct", "none"],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "Ingress",
      "type": "object"
    },
    "Kubernetes": {
      "additionalProperties": false,
      "properties": {
        "pod_cidr": {
          "$ref": "#/$defs/Cidr",
          "default": "10.42.0.0/16"
        },
        "svc_cidr": {
          "$ref": "#/$defs/Cidr",
          "default": "10.43.0.0/16"
        },
        "coredns_addr": {
          "format": "ipv4",
          "title": "Coredns Addr",
          "type": "string"
        },
        "api": {
          "$ref": "#/$defs/Api",
          "default": {
            "addr": null,
            "host": null,
            "tls_sans": null
          }
        }
      },
      "title": "Kubernetes",
      "type": "object"
    },
    "Network": {
      "additionalProperties": false,
      "properties": {
        "node_cidr": {
          "$ref": "#/$defs/Cidr"
        },
        "dns_servers": {
          "default": ["1.1.1.1", "1.0.0.1"],
          "items": {
            "format": "ipv4",
            "type": "string"
          },
          "title": "Dns Servers",
          "type": "array"
        },
        "ntp_servers": {
          "default": ["162.159.200.1", "162.159.200.123"],
          "items": {
            "format": "ipv4",
            "type": "string"
          },
          "title": "Ntp Servers",
          "type": "array"
        },
        "default_gateway": {
          "format": "ipv4",
          "title": "Default Gateway",
          "type": "string"
        },
        "vlan_tag": {
          "anyOf": [
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vlan Tag"
        }
      },
      "required": ["node_cidr"],
      "title": "Network",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z0-9][a-z0-9\\-]{0,61}[a-z0-9]$|^[a-z0-9]$",
          "title": "Name",
          "type": "string"
        },
        "address": {
          "anyOf": [
            {
              "format": "ipv4",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "controller": {
          "title": "Controller",
          "type": "boolean"
        },
        "disk": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disk"
        },
        "mac_addr": {
          "anyOf": [
            {
              "pattern": "^([0-9a-f]{2}:){5}[0-9a-f]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mac Addr"
        },
        "schematic_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schematic Id"
        },
        "mtu": {
          "default": 1500,
          "maximum": 9000,
          "minimum": 1450,
          "title": "Mtu",
          "type": "integer"
        },
        "secureboot": {
          "default": false,
          "title": "Secureboot",
          "type": "boolean"
        },
        "encrypt_disk": {
          "default": false,
          "title": "Encrypt Disk",
          "type": "boolean"
        },
        "kernel_modules": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Kernel Modules",
          "type": "array"
        }
      },
      "required": ["name", "controller"],
      "title": "Node",
      "type": "object"
    },
    "NodePort": {
      "maximum": 32767,
      "minimum": 30000,
      "type": "integer"
    },
    "Repository": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "pattern": "^(https?://|ssh://git@)[^/]+/.+$",
          "title": "Url",
          "type": "string"
        },
        "branch": {
          "default": "main",
          "minLength": 1,
          "title": "Branch",
          "type": "string"
        },
        "webhook_provider": {
          "default": "github",
          "enum": ["github", "gitlab", "generic-hmac", "none"],
          "title": "Webhook Provider",
          "type": "string"
        },
        "known_hosts": {
          "default": "",
          "title": "Known Hosts",
          "type": "string"
        }
      },
      "required": ["url"],
      "title": "Repository",
      "type": "object"
    },
    "Spegel": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        }
      },
      "title": "Spegel",
      "type": "object"
    },
    "Spinifex": {
      "additionalProperties": false,
      "properties": {
        "region": {
          "default": "ap-southeast-2",
          "pattern": "^[a-z]{2}-[a-z]+-[0-9]$",
          "title": "Region",
          "type": "string"
        },
        "gateway_url": {
          "default": "",
          "title": "Gateway Url",
          "type": "string"
        },
        "s3_url": {
          "default": "",
          "title": "S3 Url",
          "type": "string"
        },
        "admin_cidr": {
          "default": "",
          "title": "Admin Cidr",
          "type": "string"
        },
        "aws_profile": {
          "default": "spinifex",
          "title": "Aws Profile",
          "type": "string"
        },
        "cluster_name": {
          "default": "k8s",
          "pattern": "^[a-z][a-z0-9-]{0,20}$",
          "title": "Cluster Name",
          "type": "string"
        },
        "instance_type": {
          "default": "t3.medium",
          "pattern": "^[a-z][a-z0-9]*\\.[a-z0-9]+$",
          "title": "Instance Type",
          "type": "string"
        },
        "node_disk_size": {
          "default": 40,
          "minimum": 20,
          "title": "Node Disk Size",
          "type": "integer"
        },
        "controllers": {
          "default": 1,
          "maximum": 9,
          "minimum": 1,
          "title": "Controllers",
          "type": "integer"
        },
        "workers": {
          "default": 0,
          "maximum": 99,
          "minimum": 0,
          "title": "Workers",
          "type": "integer"
        },
        "install_disk": {
          "default": "/dev/vda",
          "pattern": "^/dev/[a-z0-9/]+$",
          "title": "Install Disk",
          "type": "string"
        },
        "ssh_host": {
          "default": "",
          "title": "Ssh Host",
          "type": "string"
        },
        "ssh_user": {
          "default": "",
          "title": "Ssh User",
          "type": "string"
        },
        "ssh_key": {
          "default": "",
          "title": "Ssh Key",
          "type": "string"
        },
        "external_node_port": {
          "$ref": "#/$defs/NodePort",
          "default": 30080
        },
        "internal_node_port": {
          "$ref": "#/$defs/NodePort",
          "default": 30081
        },
        "dns_node_port": {
          "$ref": "#/$defs/NodePort",
          "default": 30053
        },
        "endpoint": {
          "default": "",
          "title": "Endpoint",
          "type": "string"
        }
      },
      "title": "Spinifex",
      "type": "object"
    },
    "Talos": {
      "additionalProperties": false,
      "properties": {
        "schematic_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schematic Id"
        }
      },
      "title": "Talos",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "provider": {
      "default": "bare-metal",
      "enum": ["bare-metal", "spinifex"],
      "title": "Provider",
      "type": "string"
    },
    "network": {
      "$ref": "#/$defs/Network"
    },
    "kubernetes": {
      "$ref": "#/$defs/Kubernetes",
      "default": {
        "pod_cidr": "10.42.0.0/16",
        "svc_cidr": "10.43.0.0/16",
        "coredns_addr": "10.43.0.10",
        "api": {
          "addr": null,
          "host": null,
          "tls_sans": null
        }
      }
    },
    "gateways": {
      "$ref": "#/$defs/Gateways",
      "default": {
        "internal": null,
        "dns": null,
        "external": null
      }
    },
    "repository": {
      "$ref": "#/$defs/Repository"
    },
    "domain": {
      "$ref": "#/$defs/Domain"
    },
    "dns": {
      "$ref": "#/$defs/Dns"
    },
    "ingress": {
      "$ref": "#/$defs/Ingress"
    },
    "cilium": {
      "$ref": "#/$defs/Cilium",
      "default": {
        "loadbalancer_mode": null,
        "bgp": {
          "node_asn": "",
          "router_addr": "",
          "router_asn": ""
        }
      }
    },
    "talos": {
      "$ref": "#/$defs/Talos",
      "default": {
        "schematic_id": null
      }
    },
    "spegel": {
      "$ref": "#/$defs/Spegel",
      "default": {
        "enabled": null
      }
    },
    "spinifex": {
      "$ref": "#/$defs/Spinifex",
      "default": {
        "region": "ap-southeast-2",
        "gateway_url": "",
        "s3_url": "",
        "admin_cidr": "",
        "aws_profile": "spinifex",
        "cluster_name": "k8s",
        "instance_type": "t3.medium",
        "node_disk_size": 40,
        "controllers": 1,
        "workers": 0,
        "install_disk": "/dev/vda",
        "ssh_host": "",
        "ssh_user": "",
        "ssh_key": "",
        "external_node_port": 30080,
        "internal_node_port": 30081,
        "dns_node_port": 30053,
        "endpoint": "",
        "ec2_endpoint": "https://ec2.ap-southeast-2.services.internal:9999"
      }
    },
    "nodes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Node"
      },
      "title": "Nodes",
      "type": "array"
    }
  },
  "required": ["network", "repository", "domain", "dns"],
  "title": "cluster.toml",
  "type": "object"
}
